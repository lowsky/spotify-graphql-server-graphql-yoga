{
  "name": "spotify-graphql-server-graphql-yoga",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "yarn": ">=1.22.17",
    "npm": "12",
    "node": ">=16.x"
  },
  "scripts": {
    "test": "npm run simpletest",
    "build": "sass public/stylesheets/style.sass:public/stylesheets/style.css",
    "simpletest": "tsx test/schemaTest.ts",
    "printSchema": "tsx bin/printSchema.ts",
    "watch": "npm run build ; tsx watch --env-file=.env serverInit.ts",
    "start": "npm run build ; tsx --env-file=.env serverInit.ts"
  },
  "dependencies": {
    "@envelop/core": "6.0.0",
    "@graphql-tools/mock": "10.1.2",
    "@graphql-yoga/plugin-response-cache": "4.0.1",
    "@whatwg-node/fetch": "0.12.1",
    "cors": "2.8.6",
    "dataloader": "2.2.3",
    "express": "5.3.0",
    "graphql": "17.0.2",
    "graphql-yoga": "6.0.1",
    "sass": "1.106.1",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@vercel/node": "28.0.0",
    "tsx": "4.23.15"
  }
}
